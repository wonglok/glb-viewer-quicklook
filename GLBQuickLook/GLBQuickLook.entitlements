<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!--
	  Required, and not for its usual purpose: without this entitlement WebKit
	  cannot start its WebContent process from a sandboxed app, and every load
	  fails silently — no error callback, webView.url stays nil, nothing renders.
	  The viewer never talks to the network (the CSP is default-src 'none' with
	  only local origins allowed); the entitlement is purely what WebKit needs.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
